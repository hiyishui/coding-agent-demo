# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，密钥只放这里）。
# 优先级：命令行参数 > 进程环境变量 > .env

# 模型提供方：mock（默认，离线回放脚本）/ anthropic / openai（任意 OpenAI 兼容服务）
MINICODE_PROVIDER=mock
# 模型名；留空则使用 src/minicode/config.py 中 DEFAULT_MODELS 的默认值
MINICODE_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI 兼容服务：OpenAI、DeepSeek、通义千问、Ollama、vLLM ……
OPENAI_API_KEY=
# 留空表示 OpenAI 官方；例如 https://api.deepseek.com/v1 或 http://localhost:11434/v1
OPENAI_BASE_URL=
